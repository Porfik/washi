+				int k;
+				for (k = 0; k < 8; k++)
+				{
+					int ma = mp[k];
+					if (ma == 255)
+						dp[k] = c;
+					else if (ma != 0)
+						dp[k] = FZ_BLEND(c, dp[k], FZ_EXPAND(ma));
+				}
+			}
+			dp += 8;
+			mp += 8;
+			w -= 8;
+		}
+	}
 	template_span_with_color_N_general_solid(dp, mp, 1, w, color, 0);
 }
 
