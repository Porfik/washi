+static inline int
+ref_get_pixel(const Jbig2Image *image, int64_t x, int64_t y)
+{
+    if ((uint64_t) x >= (uint64_t) image->width || (uint64_t) y >= (uint64_t) image->height)
+        return 0;
+    return (image->data[((size_t) x >> 3) + (size_t) y * image->stride] >> (7 - (x & 7))) & 1;
