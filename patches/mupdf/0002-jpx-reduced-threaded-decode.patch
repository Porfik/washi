+/* washi: decode JPX at a reduced resolution when the caller is going to
+ * subsample the image anyway (l2factor), and decode with several threads.
+ * Both can be switched off at runtime for comparison. */
+int fz_washi_jpx_reduce = 1;
+int fz_washi_jpx_threads = 2;
+
+/* Largest resolution reduction we can ask OpenJPEG for, given the requested l2factor. */
+static int
+jpx_reduce_factor(opj_codec_t *codec, opj_image_t *jpx, int l2factor)
+{
+	opj_codestream_info_v2_t *info;
+	OPJ_UINT32 k;
+	int reduce = l2factor;
+
+	if (l2factor <= 0 || !fz_washi_jpx_reduce || jpx->x0 != 0 || jpx->y0 != 0)
+		return 0;
+	for (k = 0; k < jpx->numcomps; k++)
+		if (jpx->comps[k].dx != 1 || jpx->comps[k].dy != 1)
+			return 0;
+
+	info = opj_get_cstr_info(codec);
+	if (!info)
+		return 0;
+	if (!info->m_default_tile_info.tccp_info)
+		reduce = 0;
+	else
+		for (k = 0; k < info->nbcomps; k++)
+		{
+			int maxr = (int)info->m_default_tile_info.tccp_info[k].numresolutions - 1;
+			if (reduce > maxr)
+				reduce = maxr;
+		}
+	opj_destroy_cstr_info(&info);
+
+	if (reduce > 0 && !opj_set_decoded_resolution_factor(codec, (OPJ_UINT32)reduce))
+		reduce = 0;
+	return reduce;
+}
