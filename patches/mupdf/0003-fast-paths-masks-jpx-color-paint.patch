+/* Narrow the device clip to the content of the mask, with room for the scaler's
+ * filter. ctm maps the unit square onto the device. 0 if nothing is left to paint. */
+static int
+mask_content_clip(const fz_pixmap *pix, fz_matrix ctm, fz_irect *clip)
+{
+	fz_irect content;
+	fz_rect r;
+
+	if (pix->n != 1 || !mask_content_bbox(pix, &content))
+		return 0;
+	r.x0 = (float)content.x0 / pix->w;
+	r.y0 = (float)content.y0 / pix->h;
+	r.x1 = (float)content.x1 / pix->w;
+	r.y1 = (float)content.y1 / pix->h;
+	content = fz_expand_irect(fz_irect_from_rect(fz_transform_rect(r, ctm)), 2);
+	*clip = fz_intersect_irect(*clip, content);
+	return !fz_is_empty_irect(*clip);
+}
