+/* Bounding box of the non-zero samples of a 1-component mask; 0 if there are none. */
+static int
+mask_content_bbox(const fz_pixmap *pix, fz_irect *bbox)
+{
+	const unsigned char *s = pix->samples;
+	ptrdiff_t stride = pix->stride;
+	int w = pix->w, h = pix->h;
+	int x0 = w, x1 = 0, y0, y1, y, x;
+
+	for (y0 = 0; y0 < h && row_is_empty(s + y0 * stride, w); y0++)
+		;
+	if (y0 == h)
+		return 0;
+	for (y1 = h; row_is_empty(s + (y1 - 1) * stride, w); y1--)
+		;
+	/* Only the margins left of x0 and right of x1 still need looking at. */
+	for (y = y0; y < y1; y++)
+	{
+		const unsigned char *r = s + y * stride;
+		for (x = 0; x < x0; x++)
+			if (r[x])
+			{
+				x0 = x;
+				break;
+			}
+		for (x = w; x > x1; x--)
+			if (r[x - 1])
+			{
+				x1 = x;
+				break;
+			}
+	}
+	bbox->x0 = x0;
+	bbox->y0 = y0;
+	bbox->x1 = x1;
+	bbox->y1 = y1;
+	return 1;
+}
