+static int
+row_is_empty(const unsigned char *s, int n)
+{
+	uint32_t v = 0;
+	int i = 0;
+
+	for (; i + 16 <= n; i += 16)
+	{
+		uint32_t w[4];
+		memcpy(w, s + i, 16);
+		v |= w[0] | w[1] | w[2] | w[3];
+		if (v)
+			return 0;
+	}
+	for (; i < n; i++)
+		v |= s[i];
+	return v == 0;
