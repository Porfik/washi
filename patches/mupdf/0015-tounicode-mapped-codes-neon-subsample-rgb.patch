 /* Load or synthesize ToUnicode map for fonts */
 
+/* washi: the codes that a cmap maps at all (its ranges, xranges, mranges
+ * and those of its usecmaps), as sorted intervals without overlaps. A font of
+ * a few hundred glyphs often comes with a 0..65535 encoding range: looking up
+ * only these codes gives the same mappings in the same order. */
+typedef struct
+{
+	unsigned int lo, hi;
+} cpt_span;
+
+typedef struct
+{
+	cpt_span *s;
+	int len, cap;
+} cpt_spans;
+
+static void
+add_span(fz_context *ctx, cpt_spans *sp, unsigned int lo, unsigned int hi)
+{
+	if (sp->len == sp->cap)
+	{
+		int cap = sp->cap ? sp->cap * 2 : 64;
+		sp->s = fz_realloc_array(ctx, sp->s, cap, cpt_span);
+		sp->cap = cap;
+	}
+	sp->s[sp->len].lo = lo;
+	sp->s[sp->len].hi = hi;
+	sp->len++;
+}
+
+static void
+collect_spans(fz_context *ctx, cpt_spans *sp, pdf_cmap *cmap, int depth)
+{
+	int i;
+	for (i = 0; i < cmap->rlen; i++)
+		add_span(ctx, sp, cmap->ranges[i].low, cmap->ranges[i].high);
+	for (i = 0; i < cmap->xlen; i++)
+		add_span(ctx, sp, cmap->xranges[i].low, cmap->xranges[i].high);
+	for (i = 0; i < cmap->mlen; i++)
+		add_span(ctx, sp, cmap->mranges[i].low, cmap->mranges[i].low);
+	if (cmap->usecmap && depth < 64)
+		collect_spans(ctx, sp, cmap->usecmap, depth + 1);
+}
+
+static int
+cmp_span(const void *a, const void *b)
+{
+	unsigned int x = ((const cpt_span *)a)->lo, y = ((const cpt_span *)b)->lo;
+	return x < y ? -1 : x > y;
+}
+
+static void
+make_spans(fz_context *ctx, cpt_spans *sp, pdf_cmap *cmap)
+{
+	int i, n = 0;
+	collect_spans(ctx, sp, cmap, 0);
+	if (sp->len == 0)
+		return;
+	qsort(sp->s, sp->len, sizeof *sp->s, cmp_span);
+	for (i = 1; i < sp->len; i++)
+	{
+		if (sp->s[i].lo <= sp->s[n].hi || sp->s[i].lo - 1 == sp->s[n].hi)
+		{
+			if (sp->s[i].hi > sp->s[n].hi)
+				sp->s[n].hi = sp->s[i].hi;
+		}
+		else
+			sp->s[++n] = sp->s[i];
+	}
+	sp->len = n + 1;
+}
