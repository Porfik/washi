+/* washi: NEON code paths (here and in draw-scale-simple.c) give bit for bit the
+ * same result as the plain code; 0 switches them off for comparison. */
+int fz_washi_neon = 1;
+
+#if defined(ARCH_ARM) && ARCH_HAS_NEON
+#include <arm_neon.h>
+
+/* washi: ((r+1)*77 + (g+1)*150 + (b+1)*28) >> 8 for sixteen pixels at a time;
+ * the sum is at most 65280 and fits a 16 bit lane. Returns how many were done. */
+static size_t
+neon_rgb_to_gray(unsigned char *d, const unsigned char *s, size_t w)
+{
+	const uint8x8_t kr = vdup_n_u8(77), kg = vdup_n_u8(150), kb = vdup_n_u8(28);
+	const uint16x8_t round = vdupq_n_u16(77 + 150 + 28);
+	size_t x;
+
+	for (x = 0; x + 16 <= w; x += 16, s += 48, d += 16)
+	{
+		uint8x16x3_t p = vld3q_u8(s);
+		uint16x8_t lo = vmlal_u8(vmlal_u8(vmlal_u8(round, vget_low_u8(p.val[0]), kr), vget_low_u8(p.val[1]), kg), vget_low_u8(p.val[2]), kb);
+		uint16x8_t hi = vmlal_u8(vmlal_u8(vmlal_u8(round, vget_high_u8(p.val[0]), kr), vget_high_u8(p.val[1]), kg), vget_high_u8(p.val[2]), kb);
+		vst1q_u8(d, vcombine_u8(vshrn_n_u16(lo, 8), vshrn_n_u16(hi, 8)));
+	}
+	return x;
+}
+#endif
