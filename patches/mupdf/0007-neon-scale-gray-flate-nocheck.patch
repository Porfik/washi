+/* washi: NEON versions of scale_row_to_temp1 and scale_row_from_temp with the
+ * same integer arithmetic, so the result is bit for bit the same. Weights from
+ * make_weights are 0..256 and add up to at most 256 per pixel, hence
+ * 128 + sum(w * v) <= 65408 fits a 16 bit lane; anything else is left to the
+ * plain code. fz_washi_neon (color-fast.c) switches it off for comparison. */
+extern int fz_washi_neon;
+
+#if defined(ARCH_ARM) && ARCH_HAS_NEON
+#include <arm_neon.h>
+#define WASHI_NEON_SCALE
+
+/* Horizontal pass: eight output pixels at a time. Their source pixels lie in one
+ * 32 byte window; for each weight position k a table lookup (vtbl4) gathers the
+ * eight source bytes and a multiply-accumulate adds them in. */
+#define NEON_WINDOW 32
+#define NEON_MAX_TAPS 12
+
+typedef struct
+{
+	int base;	/* first byte of the source window */
+	int taps;	/* weight positions used; 0 — this group is done the plain way */
+	int wide;	/* a weight is 256, so the u16 multiply is needed */
+	int contrib;	/* index of the group's first record in weights->index */
+	uint8_t idx[NEON_MAX_TAPS][8];	/* window offsets; 0xff gives 0 */
+	uint8_t w8[NEON_MAX_TAPS][8];
+	uint16_t w16[NEON_MAX_TAPS][8];
+} neon_group;
+
+typedef struct
+{
+	int groups;		/* full groups of eight */
+	int tail_contrib;	/* index of the record of the first pixel after them */
+	neon_group group[FZ_FLEXIBLE_ARRAY];
+} neon_plan;
+
+static neon_plan *
+neon_plan_new(fz_context *ctx, const fz_weights *weights, int src_w)
+{
+	int groups = weights->count / 8;
+	int pos = weights->index[0];
+	neon_plan *plan;
+	int g, i, k;
+
+	if (weights->flip || weights->n != 1 || groups == 0 || src_w < NEON_WINDOW)
+		return NULL;
+	plan = fz_malloc_no_throw(ctx, offsetof(neon_plan, group) + sizeof(neon_group) * (size_t)groups);
+	if (!plan)
+		return NULL;
+	plan->groups = groups;
+	for (g = 0; g < groups; g++)
+	{
+		neon_group *grp = &plan->group[g];
+		int mins[8], lens[8], wpos[8];
+		int lo = INT_MAX, hi = 0, taps = 0, ok = 1, wide = 0;
+
+		grp->contrib = pos;
+		for (i = 0; i < 8; i++)
+		{
+			int sum = 0;
+			mins[i] = weights->index[pos++];
+			lens[i] = weights->index[pos++];
+			wpos[i] = pos;
+			for (k = 0; k < lens[i]; k++)
+			{
+				int v = weights->index[pos + k];
+				if (v < 0 || v > 256)
+					ok = 0;
+				wide |= v == 256;
+				sum += v;
+			}
+			if (sum > 256)
+				ok = 0;
+			pos += lens[i];
+			lo = fz_mini(lo, mins[i]);
+			hi = fz_maxi(hi, mins[i] + lens[i]);
+			taps = fz_maxi(taps, lens[i]);
+		}
+		/* The window is read whole, so it must not pass the end of the row. */
+		if (lo + NEON_WINDOW > src_w)
+			lo = src_w - NEON_WINDOW;
+		if (!ok || hi - lo > NEON_WINDOW || taps > NEON_MAX_TAPS)
+			taps = 0;
+		grp->base = lo;
+		grp->taps = taps;
+		grp->wide = wide;
+		for (k = 0; k < taps; k++)
+			for (i = 0; i < 8; i++)
+			{
+				int in = k < lens[i];
+				int v = in ? weights->index[wpos[i] + k] : 0;
+				grp->idx[k][i] = in ? mins[i] + k - lo : 0xff;
+				grp->w8[k][i] = (uint8_t)v;
+				grp->w16[k][i] = (uint16_t)v;
+			}
+	}
+	plan->tail_contrib = pos;
+	return plan;
+}
+
+/* The plain arithmetic of scale_row_to_temp1 (not flipped) for count pixels. */
+static void
+plain_row_to_temp1(unsigned char * FZ_RESTRICT dst, const unsigned char * FZ_RESTRICT src, const int *contrib, int count)
+{
+	while (count-- > 0)
+	{
+		const unsigned char *min = &src[*contrib++];
+		int len = *contrib++;
+		int a = 128;
+		while (len-- > 0)
+			a += *min++ * *contrib++;
+		*dst++ = (unsigned char)(a >> 8);
+	}
+}
+
+static void
+neon_row_to_temp1(unsigned char * FZ_RESTRICT dst, const unsigned char * FZ_RESTRICT src, const fz_weights * FZ_RESTRICT weights, const neon_plan *plan)
+{
+	int g, k;
+
+	for (g = 0; g < plan->groups; g++, dst += 8)
+	{
+		const neon_group *grp = &plan->group[g];
+		const uint8_t *s = src + grp->base;
+		uint8x16_t q0, q1;
+		uint8x8x4_t tbl;
+		uint16x8_t acc;
+
+		if (grp->taps == 0)
+		{
+			plain_row_to_temp1(dst, src, &weights->index[grp->contrib], 8);
+			continue;
+		}
+		q0 = vld1q_u8(s);
+		q1 = vld1q_u8(s + 16);
+		tbl.val[0] = vget_low_u8(q0);
+		tbl.val[1] = vget_high_u8(q0);
+		tbl.val[2] = vget_low_u8(q1);
+		tbl.val[3] = vget_high_u8(q1);
+		acc = vdupq_n_u16(128);
+		if (grp->wide)
+			for (k = 0; k < grp->taps; k++)
+				acc = vmlaq_u16(acc, vmovl_u8(vtbl4_u8(tbl, vld1_u8(grp->idx[k]))), vld1q_u16(grp->w16[k]));
+		else
+			for (k = 0; k < grp->taps; k++)
+				acc = vmlal_u8(acc, vtbl4_u8(tbl, vld1_u8(grp->idx[k])), vld1_u8(grp->w8[k]));
+		vst1_u8(dst, vshrn_n_u16(acc, 8));
+	}
+	plain_row_to_temp1(dst, src, &weights->index[plan->tail_contrib], weights->count - 8 * plan->groups);
+}
+
+/* Vertical pass: sixteen bytes at a time, rows with zero weight skipped. */
+static void
+neon_row_from_temp(unsigned char * FZ_RESTRICT dst, const unsigned char * FZ_RESTRICT src, const fz_weights * FZ_RESTRICT weights, int w, int n, int row)
+{
+	const int *contrib = &weights->index[weights->index[row]];
+	const unsigned char *rows[64];
+	uint8_t wk[64];
+	int width = w * n;
+	int len, k, x, nz = 0, sum = 0;
+
+	contrib++; /* Skip min */
+	len = *contrib++;
+	if (len > 64)
+	{
+		scale_row_from_temp(dst, src, weights, w, n, row);
+		return;
+	}
+	for (k = 0; k < len; k++)
+	{
+		int v = contrib[k];
+		if (v < 0 || v > 256)
+		{
+			scale_row_from_temp(dst, src, weights, w, n, row);
+			return;
+		}
+		sum += v;
+		if (v == 0)
+			continue;
+		if (v == 256)
+		{
+			/* All the other weights are 0: (128 + 256 * v) >> 8 == v. */
+			memcpy(dst, src + (size_t)k * width, width);
+			return;
+		}
+		rows[nz] = src + (size_t)k * width;
+		wk[nz++] = (uint8_t)v;
+	}
+	if (sum > 256)
+	{
+		scale_row_from_temp(dst, src, weights, w, n, row);
+		return;
+	}
+	for (x = 0; x + 16 <= width; x += 16)
+	{
+		uint16x8_t lo = vdupq_n_u16(128), hi = lo;
+		for (k = 0; k < nz; k++)
+		{
+			uint8x16_t v = vld1q_u8(rows[k] + x);
+			uint8x8_t wv = vdup_n_u8(wk[k]);
+			lo = vmlal_u8(lo, vget_low_u8(v), wv);
+			hi = vmlal_u8(hi, vget_high_u8(v), wv);
+		}
+		vst1q_u8(dst + x, vcombine_u8(vshrn_n_u16(lo, 8), vshrn_n_u16(hi, 8)));
+	}
+	for (; x < width; x++)
+	{
+		int val = 128;
+		for (k = 0; k < nz; k++)
+			val += rows[k][x] * wk[k];
+		dst[x] = (unsigned char)(val >> 8);
+	}
+}
+#endif
