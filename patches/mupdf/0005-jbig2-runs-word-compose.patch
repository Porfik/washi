+/* washi: a decision is the MPS without renormalization while A - Qe stays
+   above C >> 16 and keeps bit 15; neither C nor the context changes then, so
+   n such decisions in a row only subtract n * Qe from A. */
+uint32_t
+jbig2_arith_mps_run(Jbig2ArithState *as, Jbig2ArithCx cx, uint32_t unit)
+{
+    unsigned int index = cx & 0x7f;
+    uint32_t low;
+
+    if (index >= MAX_QE_ARRAY_SIZE || unit == 0)
+        return 0;
+    low = as->C >> 16;
+    low = low < 0x8000 ? 0x8000 : low + 1;
+    if (as->A < low)
+        return 0;
+    return (as->A - low) / (jbig2_arith_Qe[index].Qe * unit);
+}
+
+void
+jbig2_arith_take_mps(Jbig2ArithState *as, Jbig2ArithCx cx, uint32_t unit, uint32_t n)
+{
+    as->A -= n * unit * jbig2_arith_Qe[cx & 0x7f].Qe;
+}
