+/* washi: fz_subsample_pixmap_ARM for one component and f = 2 or 4 with NEON:
+ * full f x f blocks are summed pairwise and shifted, exactly as the asm does;
+ * the stray column and row are divided as there (v * (65536 / count)) >> 16. */
+static int
+neon_subsample_gray(unsigned char *s, int w, int h, int factor, ptrdiff_t stride)
+{
+	int f = 1 << factor, shift = 2 * factor;
+	int ow = w / f, sx = w % f, sy = h % f;
+	unsigned char *d = s;
+	int x, y, xx, yy;
+
+	if (factor != 1 && factor != 2)
+		return 0;
+	for (y = 0; y + f <= h; y += f)
+	{
+		const unsigned char *r = s + (size_t)y * stride;
+		x = 0;
+		if (f == 2)
+			for (; x + 16 <= ow; x += 16)
+			{
+				const unsigned char *a = r + 2 * x, *b = a + stride;
+				uint8x16_t a0 = vld1q_u8(a), a1 = vld1q_u8(a + 16);
+				uint8x16_t b0 = vld1q_u8(b), b1 = vld1q_u8(b + 16);
+				uint16x8_t s0 = vaddq_u16(vpaddlq_u8(a0), vpaddlq_u8(b0));
+				uint16x8_t s1 = vaddq_u16(vpaddlq_u8(a1), vpaddlq_u8(b1));
+				vst1q_u8(d + x, vcombine_u8(vshrn_n_u16(s0, 2), vshrn_n_u16(s1, 2)));
+			}
+		else
+			for (; x + 8 <= ow; x += 8)
+			{
+				const unsigned char *a = r + 4 * x;
+				uint16x8_t p0 = vdupq_n_u16(0), p1 = p0;
+				for (yy = 0; yy < 4; yy++, a += stride)
+				{
+					p0 = vaddq_u16(p0, vpaddlq_u8(vld1q_u8(a)));
+					p1 = vaddq_u16(p1, vpaddlq_u8(vld1q_u8(a + 16)));
+				}
+				p0 = vcombine_u16(vpadd_u16(vget_low_u16(p0), vget_high_u16(p0)),
+						vpadd_u16(vget_low_u16(p1), vget_high_u16(p1)));
+				vst1_u8(d + x, vshrn_n_u16(p0, 4));
+			}
+		for (; x < ow; x++)
+		{
+			int v = 0;
+			for (yy = 0; yy < f; yy++)
+				for (xx = 0; xx < f; xx++)
+					v += r[yy * stride + x * f + xx];
+			d[x] = v >> shift;
+		}
+		if (sx)
+		{
+			int v = 0;
+			for (yy = 0; yy < f; yy++)
+				for (xx = 0; xx < sx; xx++)
+					v += r[yy * stride + ow * f + xx];
+			d[ow] = (v * (65536 / (sx * f))) >> 16;
+		}
+		d += ow + (sx != 0);
+	}
+	if (sy)
+	{
+		const unsigned char *r = s + (size_t)y * stride;
+		for (x = 0; x < ow; x++)
+		{
+			int v = 0;
+			for (yy = 0; yy < sy; yy++)
+				for (xx = 0; xx < f; xx++)
+					v += r[yy * stride + x * f + xx];
+			d[x] = (v * (65536 / (sy * f))) >> 16;
+		}
+		if (sx)
+		{
+			int v = 0;
+			for (yy = 0; yy < sy; yy++)
+				for (xx = 0; xx < sx; xx++)
+					v += r[yy * stride + ow * f + xx];
+			d[ow] = (v * (65536 / (sx * sy))) >> 16;
+		}
+	}
+	return 1;
+}
