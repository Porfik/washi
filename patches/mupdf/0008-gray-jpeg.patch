+/* washi: decode colour (RGB) JPEGs to gray straight away — the JPEG's own luma
+ * instead of RGB converted to gray afterwards. Only for a gray destination, which the
+ * reader always has; the result differs from MuPDF's by rounding. 0 — off. */
+int fz_washi_gray_jpeg = 0;
+
+static int
+washi_jpeg_to_gray(fz_context *ctx, const fz_compressed_image *image)
+{
+	const fz_image *im = &image->super;
+	return fz_washi_gray_jpeg && image->buffer->params.type == FZ_IMAGE_JPEG &&
+		im->n == 3 && im->bpc == 8 && !im->imagemask && !im->use_colorkey && !im->use_decode &&
+		im->colorspace && fz_colorspace_type(ctx, im->colorspace) == FZ_COLORSPACE_RGB;
+}
+
