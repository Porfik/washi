+/* washi: the part of the clip group (a) that differs from the backdrop (b). */
+static fz_irect
+washi_changed_area(const fz_pixmap *a, const fz_pixmap *b)
+{
+	fz_irect r = fz_empty_irect;
+	size_t len = (size_t)a->w * a->n;
+	int y;
+
+	for (y = 0; y < a->h; y++)
+	{
+		const unsigned char *pa = a->samples + (size_t)y * a->stride;
+		const unsigned char *pb = b->samples + (size_t)(a->y - b->y + y) * b->stride + (size_t)(a->x - b->x) * b->n;
+		size_t lo, hi;
+		if (memcmp(pa, pb, len) == 0)
+			continue;
+		for (lo = 0; pa[lo] == pb[lo]; lo++)
+			;
+		for (hi = len; pa[hi - 1] == pb[hi - 1]; hi--)
+			;
+		if (fz_is_empty_irect(r))
+		{
+			r.x0 = a->x + (int)(lo / a->n);
+			r.x1 = a->x + (int)((hi + a->n - 1) / a->n);
+			r.y0 = a->y + y;
+		}
+		else
+		{
+			r.x0 = fz_mini(r.x0, a->x + (int)(lo / a->n));
+			r.x1 = fz_maxi(r.x1, a->x + (int)((hi + a->n - 1) / a->n));
+		}
+		r.y1 = a->y + y + 1;
+	}
+	return r;
+}
