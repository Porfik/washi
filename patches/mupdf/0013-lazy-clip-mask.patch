+/* washi: pop of a clip from fz_draw_clip_path with a kept path: the mask
+ * made and applied only where the group was drawn to. The path is flattened
+ * with the same clip as MuPDF would have, so the coverage is the same; the
+ * scan conversion is then limited to the (smaller) mask pixmap. */
+static void
+washi_pop_lazy_clip(fz_context *ctx, fz_draw_device *dev, fz_draw_state *state)
+{
+	fz_pixmap *mask = NULL;
+
+	fz_var(mask);
+	fz_try(ctx)
+	{
+		fz_irect area = washi_changed_area(state[1].dest, state[0].dest);
+		if (!fz_is_empty_irect(area) &&
+			!fz_flatten_fill_path(ctx, dev->rast, state[1].lazy_path, state[1].lazy_ctm, state[1].lazy_flatness, state[1].lazy_scissor, NULL))
+		{
+			mask = fz_new_pixmap_with_bbox(ctx, NULL, area, NULL, 1);
+			fz_clear_pixmap(ctx, mask);
+			fz_convert_rasterizer(ctx, dev->rast, state[1].lazy_even_odd, mask, NULL, 0);
+			fz_paint_pixmap_with_mask(state[0].dest, state[1].dest, mask);
+		}
+	}
+	fz_always(ctx)
+	{
+		fz_drop_pixmap(ctx, mask);
+		fz_drop_path(ctx, state[1].lazy_path);
+		state[1].lazy_path = NULL;
+		cleanup_post_pop(ctx, state);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+}
