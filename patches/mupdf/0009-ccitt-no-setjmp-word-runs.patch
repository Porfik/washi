+/* washi: the decoded row to the output, inverted four bytes at a time. */
+static unsigned char *
+copy_row(fz_faxd *fax, unsigned char *p, unsigned char *ep)
+{
+	size_t n = fz_minz(fax->wp - fax->rp, ep - p), k = 0;
+	if (fax->black_is_1)
+		memcpy(p, fax->rp, n);
+	else
+	{
+		for (; k + 4 <= n; k += 4)
+		{
+			uint32_t v;
+			memcpy(&v, fax->rp + k, 4);
+			v = ~v;
+			memcpy(p + k, &v, 4);
+		}
+		for (; k < n; k++)
+			p[k] = fax->rp[k] ^ 0xff;
 	}
+	fax->rp += n;
+	return p + n;
 }
 
